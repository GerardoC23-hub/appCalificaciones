<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== Encabezado ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de Calificaciones"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E3F"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TDA Estudiante · Arquitectura MVP"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- ===== Tarjeta: Datos del estudiante ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos del estudiante"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="#2E8B57"
                    android:hint="Nombre del estudiante">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== Tarjeta: Calificaciones (materias fijas) ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calificaciones (0 a 10)"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- Las filas (materia fija + campo de nota) se agregan por código -->
                <LinearLayout
                    android:id="@+id/layoutNotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== Tarjeta: Beca ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beca (opcional)"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <CheckBox
                    android:id="@+id/chkBecado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Es becado? (el porcentaje se calcula con el promedio)" />

                <!-- Solo se muestra cuando se marca "Es becado" -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilColegiatura"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:boxStrokeColor="#2E8B57"
                    android:hint="Monto de la colegiatura">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtColegiatura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== Botón ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CALCULAR"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:backgroundTint="#1B5E3F"
            android:layout_marginBottom="18dp" />

        <!-- ===== Resultados (ocultos hasta calcular) ===== -->
        <LinearLayout
            android:id="@+id/layoutResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Estado: va primero -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E3F" />
            </androidx.cardview.widget.CardView>

            <!-- Calificaciones por materia -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CALIFICACIONES"
                        android:textStyle="bold"
                        android:textColor="#6B7280"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <!-- Las filas se agregan por código -->
                    <LinearLayout
                        android:id="@+id/layoutCalificaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Resultados generales -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESULTADOS"
                        android:textStyle="bold"
                        android:textColor="#6B7280"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtNombreMostrado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/txtPromedio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#2E8B57"
                        android:paddingVertical="6dp"
                        android:background="#F0F0F0" />

                    <TextView
                        android:id="@+id/txtNotaMaxima"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/txtNotaMinima"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp"
                        android:background="#F0F0F0" />

                    <TextView
                        android:id="@+id/txtAprobadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/txtReprobadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp"
                        android:background="#F0F0F0" />

                    <TextView
                        android:id="@+id/txtBeca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/txtMontoAPagar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1C1C1E"
                        android:paddingVertical="6dp"
                        android:background="#F0F0F0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ===== Autor ===== -->
        <TextView
            android:id="@+id/txtAutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#9CA3AF"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>